# =================================================================
# AI-Assisted Smart Hostel & Residential Management Platform
# Production & Docker Environment Variables Template (.env.example)
# =================================================================
# Copy this file to '.env' before deploying:
#   cp .env.example .env
# Replace placeholder values with strong, random credentials.

# -----------------------------------------------------------------
# 1. Environment & Operational Mode
# -----------------------------------------------------------------
# Options: development | production
FLASK_ENV=production

# -----------------------------------------------------------------
# 2. Security Keys (REQUIRED: Minimum 32 characters in production)
# -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secure_flask_secret_key_minimum_32_characters_here
JWT_SECRET_KEY=your_secure_jwt_secret_key_minimum_32_characters_here
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# -----------------------------------------------------------------
# 3. Database Configuration
# -----------------------------------------------------------------
# Option A: MySQL for Docker Compose / Production
# (Matches service name 'db' inside docker-compose)
MYSQL_DATABASE=hostel_db
MYSQL_USER=hostel_user
MYSQL_PASSWORD=your_secure_mysql_user_password_here
MYSQL_ROOT_PASSWORD=your_secure_mysql_root_password_here
MYSQL_PORT=3306

DATABASE_URL=mysql+pymysql://hostel_user:your_secure_mysql_user_password_here@db:3306/hostel_db

# Option B: SQLite for zero-config local development without MySQL:
# DATABASE_URL=sqlite:///hostel_management.db

# -----------------------------------------------------------------
# 4. Networking & Ports
# -----------------------------------------------------------------
PORT=5000
FRONTEND_PORT=80

# Allowed CORS Origins (comma-separated domains)
FRONTEND_URL=http://localhost,http://127.0.0.1,http://localhost:80

# -----------------------------------------------------------------
# 5. Email Notifications (Optional - In-App Notifier is Default)
# -----------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@domain.com
SMTP_PASSWORD=your_app_specific_email_password
MAIL_DEFAULT_SENDER=noreply@sruhostel.edu
