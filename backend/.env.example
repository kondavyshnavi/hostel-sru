# Database Configuration
# For MySQL: mysql+pymysql://<user>:<password>@localhost:3306/hostel_db
# For SQLite (zero-config local dev & testing): sqlite:///hostel_management.db
DATABASE_URL=sqlite:///hostel_management.db

# Flask Application Secret & JWT Secret
SECRET_KEY=dev_secret_key_change_in_production_hostel_management_2026
JWT_SECRET_KEY=jwt_secret_key_change_in_production_hostel_2026
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000

# Email / SMTP Configuration (Optional - in-app notifier works automatically)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@sruhostel.edu
